# Copy to .env and adjust per room instance.

# Absolute path to the checked-out repo (the directory containing this file,
# plus backend/ and frontend/). Only needed when docker-compose.yml itself
# lives somewhere other than the repo root — e.g. Unraid's Compose Manager
# plugin copies the compose file into its own
# /boot/config/plugins/compose.manager/projects/<name>/ folder, separate
# from wherever you cloned the repo, so the default relative "./backend" /
# "./frontend" build contexts won't resolve. Point this at the repo instead,
# e.g. /mnt/user/appdata/attic-tracking-repo. Leave unset if the compose
# file sits next to backend/ and frontend/ as checked out.
# APP_PATH=/mnt/user/appdata/attic-tracking-repo

# Port the frontend (nginx, serving both the SPA and proxying /api) is
# published on. Use a distinct value + a distinct COMPOSE_PROJECT_NAME
# (or a separate checkout dir) for each room you deploy.
HOST_PORT=8080

# Where the SQLite file is kept on the host, bind-mounted into the backend
# container. Defaults to ./data for local use; on Unraid point this at the
# array, e.g. /mnt/user/appdata/attic-tracking-<room>/data, so it's covered
# by normal appdata backups. Use a distinct path per room instance.
DATA_PATH=./data
