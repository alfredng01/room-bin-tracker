# Copy to .env and adjust per room instance.

# Image tag to run. "latest" tracks the newest build of main; pin to a
# specific "sha-<commit>" tag to hold a room on a known-good version.
IMAGE_TAG=latest

# Host port the app is published on. Use a distinct value per room instance.
HOST_PORT=8080

# Where the SQLite file is kept on the host, bind-mounted into the container.
# Defaults to ./data for local use; on Unraid point this at the array, e.g.
# /mnt/user/appdata/attic-tracking-<room>/data, so it's covered by normal
# appdata backups. Use a distinct path per room instance.
DATA_PATH=./data
